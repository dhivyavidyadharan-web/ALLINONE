# Copy to .env for local runs. On Vercel, set the same names in Project > Settings > Environment Variables.
# Never commit .env.

# ================= CORE =================

# --- Neon: Dashboard > your project > Connect > "Pooled connection" string.
# Looks like: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Leave empty locally to use a throwaway SQLite file instead.
DATABASE_URL=

# --- Gemini: aistudio.google.com > Get API key
GEMINI_API_KEY=
# mock = offline deterministic model (no key needed). live = real Gemini calls.
LLM_MODE=mock
MODEL_SCORE=gemini-4-hydrogen
MODEL_EXTRACT=gemini-3.5-flash-lite
MODEL_WRITE=gemini-3.5-flash-lite
# Fallback mechanism: tried in order when the primary keeps failing (comma-separated)
FALLBACK_SCORE=gemini-3.8-flash
FALLBACK_EXTRACT=gemini-3.1-flash-lite
FALLBACK_WRITE=gemini-3.1-flash-lite
RETRIES_PER_MODEL=2

# --- Security (REQUIRED on Vercel; the app refuses to serve without APP_PASSWORD there)
APP_PASSWORD=
# long random string; signs login cookies
SESSION_SECRET=
# long random string; Vercel Cron and the GitHub heartbeat send it to /api/tick
CRON_SECRET=
# optional: lets a public form POST to /api/applications with "Authorization: Bearer <token>"
INTAKE_TOKEN=

# ================= OPTIONAL ADD-ONS =================

# Portkey gateway in front of Gemini (Case 04 Task 3)
PORTKEY_API_KEY=
# Langfuse tracing (Case 04 Task 4)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Live web research: 1 = crawl applicants' real websites; 0 = offline sample pages
LIVE_WEB=0
# Scraper limits (defaults shown): pages per site, seconds per site, pause between requests, cache days
SCRAPER_MAX_PAGES=5
SCRAPER_BUDGET_S=20
SCRAPER_DELAY_S=0.5
SCRAPER_CACHE_DAYS=7
# Open-web search (Gemini + Google Search; needs LLM_MODE=live and LIVE_WEB=1)
SEARCH_MAX_RESULTS=5
# 1 = also search founder names to find their profiles (names go to the search step only)
SEARCH_FOUNDERS=1
# Google's per-request fee for search grounding, in USD. Set it from Gemini's price list so /costs and the
# daily limit include it (0 = not counted).
SEARCH_CALL_USD=0
# Slack-compatible webhook for cost/pause alerts
ALERT_WEBHOOK_URL=

# ================= TUNING =================
WORKER_CONCURRENCY=3
MAX_ATTEMPTS=3
TICK_BUDGET_S=150
DAILY_COST_LIMIT_USD=5.00
FOLLOW_UP_AFTER_DAYS=3
CLOSE_AFTER_FOLLOW_UPS=2
